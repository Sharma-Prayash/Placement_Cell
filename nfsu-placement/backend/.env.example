# Copy to .env (the setup script does this and fills in the keys). Never commit .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Column encryption (Fernet key) and blind-index (HMAC) key. Losing FIELD_ENCRYPTION_KEY makes
# encrypted columns unreadable; rotate with care and keep a sealed backup of it.
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Password for every account created by `manage.py seed_demo` (demo data only).
SEED_PASSWORD=

# Database: sqlite (default, zero setup) or postgres (docker compose up -d db)
DB_ENGINE=sqlite
POSTGRES_DB=nfsu_placement
POSTGRES_USER=nfsu_app
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional Redis for shared rate limits and cache (docker compose up -d redis)
REDIS_URL=

# Email: console backend prints mails to the Django terminal. For a real mailbox use SMTP or Mailtrap.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=placement-cell@nfsu.local
PLACEMENT_CELL_EMAIL=placement-cell@nfsu.local

# Security knobs
# Roles that must confirm a 6-digit code emailed to their official address after the password.
# Users with an authenticator app enrolled use the app instead. Remove a role to let it sign in with a password only.
MFA_REQUIRED_ROLES=admin,officer,coordinator,recruiter,student
# Addresses allowed to set X-Real-IP (your Nginx, e.g. 127.0.0.1). Leave empty when nothing sits in front of Django.
TRUSTED_PROXIES=
PUBLIC_STATS_MIN_CELL=5

# U.J. placement assistant (optional). Leave GEMINI_API_KEY empty to answer from the question bank only.
# Only interview-prep questions and approved question-bank text are sent to Gemini; personal records never are.
# Check a key with: manage.py check_gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
ASSISTANT_LLM_ENABLED=true
