# Django Secrets
DJANGO_SECRET_KEY=your-django-secret-key-here
DEBUG=True

# Database: Supabase PostgreSQL URL (format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres)
# If not provided, falls back cleanly to local sqlite3 for development and testing.
SUPABASE_DB_URL=

# Gemini LLM Configuration
GEMINI_API_KEY=
CHATBOT_LLM_ENABLED=True
